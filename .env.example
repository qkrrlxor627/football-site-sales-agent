# 이 파일을 .env로 복사해서 쓰세요. 키가 없어도 실행됩니다 (문장 이해만 키워드 규칙으로 바뀜).

# 문장 이해 (LLM). 비워 두면 키워드 규칙 모드
OPENAI_API_KEY=
PITCHROOM_MODEL=gpt-4o-mini

# 선수 → 축구화 검색. 비워 두면 고정표 사용
TAVILY_API_KEY=

# 웹 서버
PITCHROOM_HOST=127.0.0.1
PITCHROOM_PORT=8000
# 대화 체크포인트 + 계정·주문이 저장되는 SQLite 파일
PITCHROOM_DB=pitchroom.db
# 세션 쿠키 서명 키. 비워 두면 처음 실행할 때 하나 만들어 DB에 저장합니다
PITCHROOM_SECRET=
PITCHROOM_LOG_LEVEL=INFO

# ---------- 계정 · 운영 ----------
# 관리자(사장님) 계정. 비밀번호를 비워 두면 처음 실행할 때 임시 비밀번호를 만들어 서버 로그에 한 번 보여 줍니다
PITCHROOM_ADMIN_ID=admin
PITCHROOM_ADMIN_PASSWORD=
# development: 데모 계정·API 문서 켬 / production: 둘 다 끄고 쿠키를 HTTPS 전용으로 (Docker는 production으로 뜹니다)
PITCHROOM_ENV=development
# 아래는 비워 두면 PITCHROOM_ENV에 맞는 기본값을 씁니다 (1 또는 0)
PITCHROOM_DEMO=
PITCHROOM_COOKIE_SECURE=
# 1분당 요청 제한: 대화 하나 / 주소 하나 / 로그인·가입 시도
PITCHROOM_CHAT_PER_MINUTE=20
PITCHROOM_IP_PER_MINUTE=120
PITCHROOM_AUTH_PER_MINUTE=10
